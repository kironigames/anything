<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Safe Subscription Demo — Prototype</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<style>
  /* Modern compact UI styles */
  :root{
    --bg:#0f1724; --card:#071024; --accent:#7c3aed; --muted:#9aa4b2;
    --glass: rgba(255,255,255,0.03);
    --radius:12px; --maxw:980px; font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial;
  }
  *{box-sizing:border-box}
  body{margin:0; min-height:100vh; background:
    linear-gradient(180deg,#041025 0%, #071427 40%), var(--bg); color:#e6eef6; padding:28px;
    -webkit-font-smoothing:antialiased}
  .wrap{max-width:var(--maxw); margin:0 auto; display:grid; gap:18px; grid-template-columns: 1fr 380px;}
  header{display:flex; gap:12px; align-items:center}
  h1{margin:0; font-size:20px}
  .subtitle{color:var(--muted); font-size:13px}
  .card{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); padding:16px; border-radius:var(--radius); border:1px solid rgba(255,255,255,0.04)}
  form{display:flex; flex-direction:column; gap:10px}
  label{font-size:13px; color:var(--muted)}
  input[type="email"], input[type="text"], select{padding:10px; border-radius:8px; border:none; background:var(--glass); color:inherit; font-size:14px}
  .row{display:flex; gap:8px}
  .btn{background:linear-gradient(90deg,var(--accent), #5b21b6); padding:10px 14px; border-radius:10px; border:none; color:white; cursor:pointer; font-weight:700}
  .ghost{background:transparent; border:1px solid rgba(255,255,255,0.06); padding:8px 10px; border-radius:8px; color:var(--muted); cursor:pointer}
  .note{color:var(--muted); font-size:13px}
  .small{font-size:13px; color:var(--muted)}
  .list{display:flex; flex-direction:column; gap:8px; margin-top:8px}
  .sub-item{display:flex; justify-content:space-between; gap:8px; align-items:center; padding:10px; border-radius:10px; background:rgba(255,255,255,0.01); border:1px solid rgba(255,255,255,0.02)}
  .analytics{display:flex; flex-direction:column; gap:8px}
  pre {background:rgba(255,255,255,0.02); padding:10px; border-radius:8px; overflow:auto; color:var(--muted)}
  footer{grid-column:1/-1; color:var(--muted); text-align:center; font-size:13px; margin-top:6px}
  @media (max-width:900px){ .wrap{grid-template-columns:1fr} }
</style>
</head>
<body>
  <div class="wrap">
    <header>
      <div>
        <h1>Subscription UX — Safe Demo</h1>
        <div class="subtitle">Prototype UI with simulated server-side protections (for demo only)</div>
      </div>
      <div style="margin-left:auto" class="small">Demo mode — not connected to external services</div>
    </header>

    <!-- Main content -->
    <main class="card">
      <h2 style="margin-top:0">Subscribe to a Channel</h2>
      <form id="subForm" autocomplete="off" novalidate>
        <label for="channel">Choose channel</label>
        <select id="channel" required>
          <option value="dev-tutorials">Dev Tutorials</option>
          <option value="music-beats">Music Beats</option>
          <option value="gaming-insights">Gaming Insights</option>
          <option value="daily-vlogs">Daily Vlogs</option>
          <option value="ai-lab">AI Lab</option>
        </select>

        <label for="email">Your email (verification required)</label>
        <input id="email" type="email" placeholder="you@example.com" required>

        <div class="row">
          <div style="flex:1">
            <label for="display">Display name (optional)</label>
            <input id="display" type="text" placeholder="Your public name (optional)">
          </div>
          <div style="width:160px">
            <label class="small">Subscription type</label>
            <select id="plan">
              <option value="free">Free</option>
              <option value="premium">Premium</option>
            </select>
          </div>
        </div>

        <!-- CAPTCHA placeholder: in production integrate real CAPTCHA (reCAPTCHA / hCaptcha) -->
        <div>
          <label class="small">Anti-bot check</label>
          <div id="captchaBox" style="padding:10px; border-radius:8px; background:var(--glass); display:flex; align-items:center; gap:8px">
            <input type="checkbox" id="fakeCaptcha"> <label for="fakeCaptcha" class="small">I'm not a bot (demo checkbox — replace with real CAPTCHA)</label>
          </div>
        </div>

        <div style="display:flex; gap:8px; align-items:center; margin-top:6px">
          <button id="subscribeBtn" class="btn" type="button">Subscribe</button>
          <button id="verifyBtn" class="ghost" type="button">Simulate verify email</button>
          <div class="note" id="statusNote" style="margin-left:auto">Ready</div>
        </div>
        <div class="note">This demo **simulates** server-side rate limiting and email verification.</div>
      </form>

      <hr style="margin:12px 0; border:none; height:1px; background:rgba(255,255,255,0.03)">

      <h3 style="margin:0">Your local subscriptions (demo)</h3>
      <div id="subsList" class="list">
        <!-- items injected here -->
      </div>
    </main>

    <!-- Sidebar: analytics & controls -->
    <aside class="card">
      <h3 style="margin-top:0">Demo Controls & Analytics</h3>
      <div class="analytics">
        <div class="small">Note: real systems must treat high-frequency subscription attempts as abuse.</div>
        <div style="display:flex; gap:8px">
          <button id="clearLocal" class="ghost">Clear local demo subscriptions</button>
          <button id="resetServer" class="ghost">Reset simulated server</button>
        </div>
        <div style="margin-top:8px">
          <label class="small">Simulated server state</label>
          <pre id="serverState" style="height:120px">loading...</pre>
        </div>
        <div style="margin-top:8px">
          <label class="small">Event log (recent)</label>
          <pre id="eventLog" style="height:160px">[]</pre>
        </div>
      </div>
    </aside>

    <footer>
      Demo for prototyping. For real apps: implement server-side verification, limits, and anti-abuse measures.
    </footer>
  </div>

<script>
/*
  SAFE DEMO:
  - This is purely client-side simulation.
  - Do NOT use this to attempt automated creation of real accounts/subscriptions.
  - Production MUST implement server-side email verification, rate-limits, CAPTCHAs, and logging.
*/

/* -------------------------
   Simulated server (client-side) — for demo only
   - Keeps a record of subscription attempts keyed by IP-like token
   - Enforces per-email / per-token cooldowns and global daily cap
   - Records events for analytics
   In production, these must be implemented server-side and cannot be trusted on the client.
-------------------------*/
const SERVER = (() => {
  const state = {
    subscriptions: [],         // accepted subscriptions (email + channel + timestamp)
    attempts: {},              // attempts per token: { token: [timestamps] }
    events: [],                // event log
    maxPerTokenPerMinute: 5,   // demo limits
    maxPerEmailPerDay: 3,      // demo: email can only subscribe N times/day
    globalDailyCap: 1000,      // demo global cap
    resetAt: Date.now() + 24*3600*1000
  };

  function now(){ return Date.now(); }
  function tokenKey() {
    // in demo we use a persistent token per browser (like a device id)
    let t = localStorage.getItem('demo_device_token');
    if(!t){ t = 'tok_' + Math.random().toString(36).slice(2,10); localStorage.setItem('demo_device_token', t); }
    return t;
  }

  function logEvent(e){
    state.events.unshift({ ts: now(), ...e });
    // limit to last 200 events
    if(state.events.length>200) state.events.length = 200;
  }

  function canAttempt(email){
    // check global cap
    if(state.subscriptions.length >= state.globalDailyCap){
      logEvent({ type:'rejected', reason:'global_cap', email });
      return { ok:false, reason:'Global daily cap reached' };
    }
    // check email daily
    const dayAgo = now() - 24*3600*1000;
    const emailCount = state.subscriptions.filter(s => s.email === email && s.ts > dayAgo).length;
    if(emailCount >= state.maxPerEmailPerDay){
      logEvent({ type:'rejected', reason:'email_daily_cap', email, emailCount });
      return { ok:false, reason:'This email has reached daily subscription limit' };
    }
    // per-token rate limit (sliding minute)
    const token = tokenKey();
    state.attempts[token] = state.attempts[token] || [];
    // remove older than 2 minutes
    state.attempts[token] = state.attempts[token].filter(t => t > now()-2*60*1000);
    if(state.attempts[token].length >= state.maxPerTokenPerMinute){
      logEvent({ type:'rejected', reason:'token_rate_limit', token, attempts: state.attempts[token].length });
      return { ok:false, reason:'Too many attempts from your device. Please wait.' };
    }
    // allow attempt and record timestamp
    state.attempts[token].push(now());
    logEvent({ type:'attempt', email, token });
    return { ok:true };
  }

  function acceptSubscription({email, channel, display, plan}){
    const check = canAttempt(email);
    if(!check.ok) return check;
    // Accept and store as subscribed (simulate sending verification email)
    const rec = { id: 'sub_'+Math.random().toString(36).slice(2,9), email, channel, display, plan, ts: now(), verified:false };
    state.subscriptions.push(rec);
    logEvent({ type:'accepted', id: rec.id, email, channel });
    return { ok:true, record: rec };
  }

  function verifySubscription(id){
    const found = state.subscriptions.find(s => s.id === id);
    if(!found) return { ok:false, reason:'Not found' };
    found.verified = true;
    logEvent({ type:'verified', id, email: found.email });
    return { ok:true, record: found };
  }

  function reset(){
    state.subscriptions = [];
    state.attempts = {};
    state.events = [];
    state.resetAt = Date.now() + 24*3600*1000;
    logEvent({ type:'reset' });
  }

  function getState(){ return JSON.parse(JSON.stringify(state)); }

  return { acceptSubscription, verifySubscription, reset, getState };
})();

/* -------------------------
   Client UI interactions
-------------------------*/
const $ = id => document.getElementById(id);
const subsList = $('subsList');
const serverState = $('serverState');
const eventLog = $('eventLog');
const statusNote = $('statusNote');

function renderLocalSubscriptions(){
  const list = JSON.parse(localStorage.getItem('demo_subs') || '[]');
  subsList.innerHTML = '';
  if(!list.length) {
    subsList.innerHTML = '<div class="small">No local subscriptions yet. Subscribe above to test the flow.</div>';
    return;
  }
  list.forEach(s => {
    const el = document.createElement('div');
    el.className = 'sub-item';
    el.innerHTML = `
      <div>
        <div style="font-weight:700">${escapeHtml(s.channel)} ${s.verified?'<span style="color:#34d399;font-weight:800;font-size:12px;margin-left:8px">verified</span>':''}</div>
        <div class="small">${escapeHtml(s.email)} ${s.display? '• ' + escapeHtml(s.display):''}</div>
      </div>
      <div style="display:flex; gap:8px; align-items:center">
        <div class="small">${new Date(s.ts).toLocaleString()}</div>
        <button class="ghost" data-id="${s.id}">Remove</button>
      </div>
    `;
    el.querySelector('button.ghost').addEventListener('click', () => {
      const arr = JSON.parse(localStorage.getItem('demo_subs') || '[]').filter(x => x.id !== s.id);
      localStorage.setItem('demo_subs', JSON.stringify(arr));
      renderLocalSubscriptions(); updateServerView(); appendEventLog({type:'local_removed', id:s.id});
    });
    subsList.appendChild(el);
  });
}

function appendEventLog(e){
  // update event display from server as well
  eventLog.textContent = JSON.stringify(SERVER.getState().events.slice(0,50), null, 2);
}

function updateServerView(){
  const st = SERVER.getState();
  serverState.textContent = JSON.stringify({
    subscriptions_count: st.subscriptions.length,
    attempts_keys: Object.keys(st.attempts).length,
    resetAt: new Date(st.resetAt).toLocaleString()
  }, null, 2);
  appendEventLog();
}

/* form handling */
$('subscribeBtn').addEventListener('click', async () => {
  statusNote.textContent = 'Validating...';
  const channel = $('channel').value;
  const email = $('email').value.trim().toLowerCase();
  const display = $('display').value.trim();
  const plan = $('plan').value;
  const captchaChecked = $('fakeCaptcha').checked;

  // Client-side validation
  if(!email || !validateEmail(email)){ alert('Please enter a valid email'); statusNote.textContent='Ready'; return; }
  if(!captchaChecked){ alert('Please complete the anti-bot check (demo)'); statusNote.textContent='Ready'; return; }

  // Simulated server request with delay
  statusNote.textContent = 'Contacting server...';
  await sleep(600 + Math.random()*600);
  // Ask simulated server to accept (server enforces rate limits)
  const res = SERVER.acceptSubscription({ email, channel, display, plan });
  if(!res.ok){
    alert('Subscription blocked: ' + res.reason);
    statusNote.textContent = 'Blocked: ' + res.reason;
    updateServerView();
    return;
  }
  // add to local demo storage (unverified)
  const rec = { id: res.record.id, email: res.record.email, channel: res.record.channel, display: res.record.display, plan: res.record.plan, ts: res.record.ts, verified: false };
  const arr = JSON.parse(localStorage.getItem('demo_subs') || '[]');
  arr.unshift(rec);
  localStorage.setItem('demo_subs', JSON.stringify(arr));
  renderLocalSubscriptions();
  statusNote.textContent = 'Subscription created — check email to verify (simulate)';
  updateServerView();
});

$('verifyBtn').addEventListener('click', async () => {
  // In real app, user clicks verification link in email; here we ask to pick one local unverified subscription
  const arr = JSON.parse(localStorage.getItem('demo_subs') || '[]').filter(x => !x.verified);
  if(!arr.length){ alert('No unverified local subscriptions to simulate.'); return; }
  const pick = arr[0];
  // Simulate clicking verification link
  await sleep(400);
  const res = SERVER.verifySubscription(pick.id);
  if(!res.ok){ alert('Verification failed: ' + res.reason); return; }
  // update local
  const local = JSON.parse(localStorage.getItem('demo_subs') || '[]').map(s => s.id === pick.id ? {...s, verified:true} : s);
  localStorage.setItem('demo_subs', JSON.stringify(local));
  renderLocalSubscriptions(); updateServerView();
  statusNote.textContent = 'Email verified (simulated)';
});

$('clearLocal').addEventListener('click', () => {
  if(!confirm('Clear local demo subscriptions?')) return;
  localStorage.removeItem('demo_subs');
  renderLocalSubscriptions(); appendEventLog({type:'cleared_local'});
});

$('resetServer').addEventListener('click', () => {
  if(!confirm('Reset simulated server state?')) return;
  SERVER.reset();
  updateServerView();
  statusNote.textContent = 'Simulated server reset';
});

function sleep(ms){ return new Promise(res => setTimeout(res, ms)); }
function validateEmail(e){ return /\S+@\S+\.\S+/.test(e); }
function escapeHtml(s){ return String(s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

// initial render
renderLocalSubscriptions();
updateServerView();

/* show server state periodically for demo */
setInterval(()=> { updateServerView(); }, 2000);

/* End of demo script */
</script>
</body>
</html>
